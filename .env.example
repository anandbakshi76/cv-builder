# Job Matcher (Phase 6). Copy this file to .env.local and fill in ONE provider. Never commit .env.local.
# The key stays on the server: it is never sent to the browser.

# --- Option 1 (default): Anthropic Claude ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Option 2: any OpenAI-compatible service ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com

# --- Public deployments only ---
# In production the Job Matcher is OFF unless this is set (otherwise anyone could spend your API credit).
# Visitors must then type the code into the Job Matcher page.
# JOB_MATCHER_ACCESS_CODE=choose-a-long-random-code
